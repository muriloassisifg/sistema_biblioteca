# Copie para .env, na VPS, e troque os valores. O .env NÃO vai para o Git.

POSTGRES_USER=biblioteca
# Só letras e números: @ e : atrapalham o endereço do banco.
POSTGRES_PASSWORD=troque-por-uma-senha-longa
POSTGRES_DB=biblioteca

# Uma frase longa, de 32 caracteres ou mais, diferente da sua máquina.
SECRET_KEY=troque-por-uma-frase-longa-que-so-voce-conhece

# Sem domínio: DOMINIO=:80 e ENDERECO_PUBLICO=http://IP.DA.SUA.VPS
# Com domínio, o Caddy cuida do HTTPS: DOMINIO=biblioteca.exemplo.com e ENDERECO_PUBLICO=https://biblioteca.exemplo.com
DOMINIO=:80
ENDERECO_PUBLICO=http://IP.DA.SUA.VPS
