# .env  --  NAO vai para o Git (esta' no .gitignore)

# O BANCO. SQLite hoje: um arquivo que nasce sozinho aqui na raiz do projeto.
# PostgreSQL quando voce quiser: troque a linha e rode
#     poetry run alembic upgrade head
# -- o banco novo nasce com todas as migracoes, e nenhum arquivo de app/ muda.
DATABASE_URL=sqlite:///./biblioteca.db
# DATABASE_URL=postgresql+psycopg://biblioteca:senha_secreta@localhost:5432/biblioteca

# A CHAVE que assina os tokens. Quem tem esta chave fabrica cracha' de
# qualquer usuario -- por isso ela mora aqui, e nao no codigo. Em
# desenvolvimento qualquer frase longa serve (32 caracteres ou mais); em
# producao, uma sequencia aleatoria que nunca passou por um chat ou um commit.
SECRET_KEY=troque-por-uma-frase-longa-que-so-voce-conhece
